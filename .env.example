# En el backend se llaman así:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#
# En este frontend (Vite) DEBEN llevar el prefijo VITE_:
VITE_SUPABASE_URL=https://TU-SUPABASE-URL
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Opcional: gate simple (solo disuasión en cliente)
# VITE_DASH_PASSWORD=

# NUNCA uses SUPABASE_SERVICE_ROLE_KEY en el frontend.
